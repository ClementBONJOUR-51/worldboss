# Production Environment
# These values should be adjusted before deploying to production

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3001
BACKEND_ENV=production
BACKEND_LOG_LEVEL=info
NODE_ENV=production

# Frontend
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
FRONTEND_ENV=production
VITE_API_URL=https://api.yourdomain.com
VITE_WS_URL=wss://api.yourdomain.com

# Boss Configuration
BOSS_NAME=Kraken
BOSS_MAX_HP=10000
BOSS_RESPAWN_TIME=5000
BOSS_TICK_INTERVAL=2000

# Logging
LOG_LEVEL=warn

# Redis (optional, for scaling)
REDIS_URL=redis://redis:6379

# Database (future)
DATABASE_URL=postgresql://user:password@db:5432/worldboss
